<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#1C1C1E">

    <!-- Display area -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="bottom|end"
        android:padding="24dp">

        <TextView
            android:id="@+id/expressionText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="24sp"
            android:textColor="#888888"
            android:text="" />

        <TextView
            android:id="@+id/displayText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="56sp"
            android:textColor="#FFFFFF"
            android:text="0"
            android:maxLines="1"
            android:ellipsize="start" />
    </LinearLayout>

    <!-- Buttons grid -->
    <GridLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:columnCount="4"
        android:rowCount="5"
        android:padding="8dp">

        <Button android:id="@+id/btnClear" android:text="C" style="@style/CalcButtonFunction"/>
        <Button android:id="@+id/btnPlusMinus" android:text="+/-" style="@style/CalcButtonFunction"/>
        <Button android:id="@+id/btnPercent" android:text="%" style="@style/CalcButtonFunction"/>
        <Button android:id="@+id/btnDivide" android:text="÷" style="@style/CalcButtonOperator"/>

        <Button android:id="@+id/btn7" android:text="7" style="@style/CalcButtonNumber"/>
        <Button android:id="@+id/btn8" android:text="8" style="@style/CalcButtonNumber"/>
        <Button android:id="@+id/btn9" android:text="9" style="@style/CalcButtonNumber"/>
        <Button android:id="@+id/btnMultiply" android:text="×" style="@style/CalcButtonOperator"/>

        <Button android:id="@+id/btn4" android:text="4" style="@style/CalcButtonNumber"/>
        <Button android:id="@+id/btn5" android:text="5" style="@style/CalcButtonNumber"/>
        <Button android:id="@+id/btn6" android:text="6" style="@style/CalcButtonNumber"/>
        <Button android:id="@+id/btnSubtract" android:text="−" style="@style/CalcButtonOperator"/>

        <Button android:id="@+id/btn1" android:text="1" style="@style/CalcButtonNumber"/>
        <Button android:id="@+id/btn2" android:text="2" style="@style/CalcButtonNumber"/>
        <Button android:id="@+id/btn3" android:text="3" style="@style/CalcButtonNumber"/>
        <Button android:id="@+id/btnAdd" android:text="+" style="@style/CalcButtonOperator"/>

        <Button android:id="@+id/btnDelete" android:text="⌫" style="@style/CalcButtonFunction"/>
        <Button android:id="@+id/btn0" android:text="0" style="@style/CalcButtonNumber"/>
        <Button android:id="@+id/btnDecimal" android:text="." style="@style/CalcButtonNumber"/>
        <Button android:id="@+id/btnEquals" android:text="=" style="@style/CalcButtonEquals"/>

    </GridLayout>

</LinearLayout>
